{
  "functions": {
    "api/index.ts": {
      "includeFiles": ["dist/index.html"]
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api"
    },
    {
      "source": "/robots.txt",
      "destination": "/api"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/categories/:categorySlug/:recipeSlug",
      "destination": "/api"
    }
  ]
}
