{
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/cloudinary-signature",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/cloudinary-delete",
      "destination": "/api/index.ts"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index.ts"
    },
    {
      "source": "/categories/:categorySlug/:recipeSlug",
      "destination": "/api/index.ts"
    }
  ]
}
