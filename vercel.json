{
  "functions": {
    "api/recipe.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/categories/:categorySlug/:recipeSlug",
      "destination": "/api/recipe"
    }
  ]
}
